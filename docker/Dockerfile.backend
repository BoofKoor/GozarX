# syntax=docker/dockerfile:1
#
# One image, two roles (app + worker); the role is chosen by the container command.
# Build context is the repo root so we can COPY backend/ and docker/entrypoint.sh.

FROM python:3.12-slim AS base

# uv (pinned to match the toolchain that produced uv.lock).
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /bin/

# Runtime tools baked in now so no later image change is needed:
#   curl            -> container healthcheck
#   postgresql-client -> Phase 8 pg_dump backups
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 1) Dependency layer — cached unless pyproject.toml / uv.lock change.
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# 2) Application source, then install the project itself (editable) into the venv.
COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Boot script (stable migrate -> seed -> uvicorn sequence).
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
CMD ["/entrypoint.sh"]
