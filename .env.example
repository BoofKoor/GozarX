# Copy to .env and fill in. The Phase 9 installer auto-generates the secret
# values and writes a complete .env for you. Trial economics and locations are
# NOT here — they are runtime settings configured from the admin panel wizard.

# ── Telegram bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=123456:replace-with-botfather-token
BOT_USERNAME=YourBot
# Comma-separated Telegram user IDs of bot owners/admins.
OWNERS=111111111,222222222
# Public domain serving the bot + admin panel (no scheme).
DOMAIN=bot.example.com
# Optional separate domain for the admin panel (leave blank to serve on DOMAIN).
ADMIN_DOMAIN=

# ── Website / SEO ────────────────────────────────────────────────────────────
# The public site's canonical origin (robots.txt, sitemap.xml, Open Graph, canonical URLs) is
# https://${DOMAIN} — set automatically from DOMAIN above, no separate var needed.
# Optional: Google Search Console verification via the "HTML tag" method. Leave blank to verify the
# property by DNS instead (recommended — no rebuild). If you use the tag method, paste ONLY the
# content token (the value inside content="…"), then rebuild the site image.
GOOGLE_SITE_VERIFICATION=

# ── Webhook security ─────────────────────────────────────────────────────────
# Telegram posts updates to /tg/<WEBHOOK_SECRET>.
WEBHOOK_SECRET=replace-with-random-url-safe-secret
# Verified against Telegram's X-Telegram-Bot-Api-Secret-Token request header.
WEBHOOK_HEADER_SECRET=replace-with-random-secret

# ── Remnawave panel ──────────────────────────────────────────────────────────
PANEL_BASE_URL=https://panel.example.com
PANEL_API_TOKEN=replace-with-remnawave-api-token
# Shared secret the panel signs its webhooks with; set the SAME value in the panel's
# webhook settings (it posts expiry/limit events to /panel-webhook).
PANEL_WEBHOOK_SECRET=replace-with-random-secret

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=gozar
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=gozar
# Must match the POSTGRES_* values above; host is the compose service name.
DATABASE_URL=postgresql+asyncpg://gozar:replace-with-strong-password@postgres:5432/gozar

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Admin panel / API ────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=replace-with-random-secret
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (the installer generates this).
ADMIN_PASSWORD_HASH=

# ── Website (separate product on shared infra) ───────────────────────────────
# The site serves at the root of this domain; the admin panel moves to /admin.
# Leave blank until the site is deployed. Site economics (site_daily_limit_mb,
# rewards, site_trial_squad, …) are runtime settings in the admin 'website' section,
# NOT env vars.
SITE_DOMAIN=
# HMAC key signing the httpOnly device-identity cookie (installer generates it).
SITE_COOKIE_SECRET=
# Cloudflare Turnstile (anti-abuse on public endpoints). Blank ⇒ verification skipped.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# Web Push (VAPID) — the installer mints the keypair. Blank ⇒ push disabled.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Contact for the VAPID 'sub' claim, e.g. mailto:admin@example.com
VAPID_SUBJECT=

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
TZ=UTC
# Telegram channel ID for database backups (Phase 8).
BACKUP_CHANNEL_ID=
