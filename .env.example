# Copy to .env and fill in. The Phase 9 installer auto-generates the secret
# values and writes a complete .env for you. Trial economics and locations are
# NOT here — they are runtime settings configured from the admin panel wizard.

# ── Telegram bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=123456:replace-with-botfather-token
BOT_USERNAME=YourBot
# Comma-separated Telegram user IDs of bot owners/admins.
OWNERS=111111111,222222222
# Public domain serving the bot + admin panel (no scheme).
DOMAIN=bot.example.com
# Optional separate domain for the admin panel (leave blank to serve on DOMAIN).
ADMIN_DOMAIN=

# ── Webhook security ─────────────────────────────────────────────────────────
# Telegram posts updates to /tg/<WEBHOOK_SECRET>.
WEBHOOK_SECRET=replace-with-random-url-safe-secret
# Verified against Telegram's X-Telegram-Bot-Api-Secret-Token request header.
WEBHOOK_HEADER_SECRET=replace-with-random-secret

# ── Remnawave panel ──────────────────────────────────────────────────────────
PANEL_BASE_URL=https://panel.example.com
PANEL_API_TOKEN=replace-with-remnawave-api-token

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=gozar
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=gozar
# Must match the POSTGRES_* values above; host is the compose service name.
DATABASE_URL=postgresql+asyncpg://gozar:replace-with-strong-password@postgres:5432/gozar

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Admin panel / API ────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=replace-with-random-secret
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (the installer generates this).
ADMIN_PASSWORD_HASH=

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
TZ=UTC
# Telegram channel ID for database backups (Phase 8).
BACKUP_CHANNEL_ID=
